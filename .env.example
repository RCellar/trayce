# Trayce environment configuration
#
# Copy to `.env` for local overrides. `.env` is gitignored.
#
# All values shown are defaults — leave a line commented out to take the
# default. Trayce reads these at server and bridge startup; there is no
# hot-reload for env changes (restart the server / relaunch Claude Code).

# ----------------------------------------------------------------------------
# Network & auth
# ----------------------------------------------------------------------------

# Bind address. Use 127.0.0.1 to restrict to localhost, 0.0.0.0 to accept
# connections from the local network.
# TRAYCE_HOST=0.0.0.0

# Server port. Must match what bridges/browsers connect to.
# TRAYCE_PORT=9740

# Auth token. If unset, the server generates a random UUID at startup and
# writes it to the state file. Bridges/browsers read it from there. Set
# explicitly if you want a stable token across restarts (required for
# container deployments where state.json isn't visible to the host).
# TRAYCE_TOKEN=

# Disable token authentication entirely. Accepted values: "1" / "true" / "yes"
# (case-insensitive). NEVER set this on a host bound to 0.0.0.0 on an
# untrusted network — the container default is true because the bridge on
# the host can't read state.json inside the container; for bare-metal setups
# leave it unset.
# TRAYCE_NO_AUTH=false

# ----------------------------------------------------------------------------
# Paths
# ----------------------------------------------------------------------------

# Where the server persists submitted PNGs. Bridge and server must agree on
# this path — in container mode it is bind-mounted so PNG paths resolve on
# both sides.
# TRAYCE_SUBMISSIONS_DIR=/tmp/trayce/submissions      # Linux/macOS default
# TRAYCE_SUBMISSIONS_DIR=%TEMP%\trayce\submissions    # Windows default

# Where the server publishes its discovery state (PID, port, token, URL).
# Bridges and lifecycle scripts read this to find the running server.
# TRAYCE_STATE_FILE=/tmp/trayce/state.json            # Linux/macOS default
# TRAYCE_STATE_FILE=%TEMP%\trayce\state.json          # Windows default

# Where the client bundle lives. Normally produced by `bun run build:client`.
# Override for tests or custom packaging.
# TRAYCE_CLIENT_DIR=dist/client

# ----------------------------------------------------------------------------
# Bridge (MCP subprocess, spawned per Claude Code session)
# ----------------------------------------------------------------------------

# Label shown in the session dropdown. Defaults to the basename of the
# directory Claude Code was launched from.
# TRAYCE_LABEL=

# ----------------------------------------------------------------------------
# Container mode
# ----------------------------------------------------------------------------

# Treat this server instance as running inside a container. Auto-detected
# via /.dockerenv on Linux; set explicitly on other runtimes if needed.
# Affects shutdown behaviour (orchestrator handles restarts, so the server
# process exits cleanly instead of respawning itself).
# TRAYCE_CONTAINER=0
