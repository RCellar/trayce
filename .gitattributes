# Normalise line endings to LF for all text files. Without this, `actions/checkout`
# on Windows runners applies core.autocrlf=true and converts every text file to
# CRLF on checkout, which breaks Biome's formatter check (it expects LF).
* text=auto eol=lf

# Explicitly mark known binary types so they aren't normalised.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
